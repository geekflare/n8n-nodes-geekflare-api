{
  "name": "n8n-nodes-geekflare-api",
  "version": "0.3.1",
  "description": "n8n community node for the Geekflare API — web scraping, screenshots, DNS, SEO, security checks and more.",
  "keywords": [
    "n8n-community-node-package",
    "n8n-nodes",
    "geekflare",
    "webscraping",
    "screenshot",
    "dns",
    "seo",
    "automation"
  ],
  "license": "MIT",
  "homepage": "https://geekflare.com",
  "author": {
    "name": "Geekflare",
    "email": "support@geekflare.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geekflare/n8n-nodes-geekflare-api.git"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && copyfiles -f nodes/Geekflare/favicon.svg dist/nodes/Geekflare/ && copyfiles -f nodes/Geekflare/favicon.svg dist/credentials/",
    "dev": "tsc --watch",
    "lint": "eslint nodes credentials",
    "lintfix": "eslint nodes credentials --fix",
    "check": "npm run lint && npm run build",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/GeekflareApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Geekflare/Geekflare.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/eslint-plugin-community-nodes": "0.35.0",
    "@types/node": "^25.9.1",
    "copyfiles": "^2.4.1",
    "eslint": "9.29.0",
    "n8n-workflow": "*",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
